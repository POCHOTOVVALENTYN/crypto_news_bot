# === Telegram Bot Settings ===
API_TOKEN=your_bot_token_here
ADMIN_ID=123456789
LOG_LEVEL=INFO

# === Telegram Userbot Settings ===
# Get these from https://my.telegram.org
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_SESSION_STRING=your_session_string_here

# === AI Providers (At least one is required) ===

# 1. Google Gemini (Free tier available)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# 2. DeepSeek (Cost-effective)
# Get key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 3. OpenAI (GPT-4o)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# 4. Hugging Face (Free Inference API)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here

# 5. Ollama (Local LLM)
# Install & Run: https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
